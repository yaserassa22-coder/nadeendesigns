# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (use ANON_KEY or PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (unsigned upload preset — must be Unsigned in Cloudinary dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
# Optional folder (default: nadeendesigns)
# NEXT_PUBLIC_CLOUDINARY_FOLDER=nadeendesigns

# Boutique contact (shown in notification emails)
NEXT_PUBLIC_BOUTIQUE_PHONE=0525999010
NEXT_PUBLIC_BOUTIQUE_EMAIL=hello@nadeendesigns.com

# Notifications master switch (default: enabled)
NOTIFICATIONS_ENABLED=true

# Resend (customer + admin HTML emails)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL="Nadeen Designs <orders@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# Twilio WhatsApp Business (notifications + OTP fallback)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: also ping admin WhatsApp on new orders
# ADMIN_WHATSAPP_TO=+9725xxxxxxxx
# Optional Twilio Content template for OTP ({{1}}=code)
# TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxx

# --- Customer WhatsApp OTP (preferred over SMS) ---
# Provider: meta | twilio | 360dialog | auto (Meta first when configured)
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API (preferred for production OTP)
# WHATSAPP_META_TOKEN=EAAxxxx
# WHATSAPP_META_PHONE_NUMBER_ID=1234567890
# WHATSAPP_META_API_VERSION=v21.0
# WHATSAPP_META_OTP_TEMPLATE=nadeen_otp
# WHATSAPP_META_OTP_TEMPLATE_LANG=ar
# WHATSAPP_META_OTP_TEMPLATE_BUTTON=true

# 360dialog (optional)
# WHATSAPP_360DIALOG_API_KEY=xxxxxxxx
# WHATSAPP_360DIALOG_BASE_URL=https://waba.360dialog.io
# WHATSAPP_360DIALOG_OTP_TEMPLATE=nadeen_otp

# Legacy Twilio SMS fallback (OTP prefers WhatsApp)
# TWILIO_SMS_FROM=+14155552671
# OTP_DEV_EXPOSE=true

# Customer OAuth via Supabase Auth (enable providers in Supabase dashboard first)
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
# NEXT_PUBLIC_APPLE_AUTH_ENABLED=true
# Redirect URL to allow: {NEXT_PUBLIC_SITE_URL}/api/auth/callback

# See docs/WHATSAPP_AUTH.md for Meta setup + security defaults.
